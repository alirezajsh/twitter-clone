<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="547.0" prefWidth="593.0" spacing="20.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo5.view.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <TabPane prefHeight="422.0" prefWidth="553.0" tabClosingPolicy="UNAVAILABLE">
     <tabs>
       <Tab text="signup">
         <content>
           <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                  <children>
                     <TextField fx:id="fullName" layoutX="203.0" layoutY="20.0" prefHeight="25.0" prefWidth="168.0" promptText="full name" />
                     <TextField fx:id="phoneNumber" layoutX="202.0" layoutY="64.0" prefHeight="25.0" prefWidth="168.0" promptText="phone numbere" />
                     <TextField fx:id="userName" layoutX="202.0" layoutY="111.0" prefHeight="25.0" prefWidth="168.0" promptText="user name" />
                     <TextField fx:id="email" layoutX="202.0" layoutY="156.0" prefHeight="25.0" prefWidth="168.0" promptText="email" />
                     <TextField fx:id="password" layoutX="202.0" layoutY="200.0" prefHeight="25.0" prefWidth="168.0" promptText="password" />
                     <TextField fx:id="confrimPassword" layoutX="202.0" layoutY="247.0" prefHeight="25.0" prefWidth="168.0" promptText="confrim password" />
                     <Button fx:id="signupButton" layoutX="250.0" layoutY="324.0" mnemonicParsing="false" onAction="#signup" prefHeight="32.0" prefWidth="73.0" style="-fx-background-color: #1F75FE; -fx-background-radius: 5px;" text="signup" textAlignment="CENTER" />
                     <Label fx:id="signupText" layoutX="193.0" layoutY="290.0" prefHeight="18.0" prefWidth="179.0" textFill="RED" />
                  </children>
               </AnchorPane>
         </content>
       </Tab>
       <Tab text="login">
         <content>
           <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                  <children>
                     <Button fx:id="loginButton" layoutX="237.0" layoutY="301.0" mnemonicParsing="false" onAction="#login" prefHeight="30.0" prefWidth="64.0" style="-fx-background-color: #1F75FE; -fx-background-radius: 5px;" text="login" />
                     <TextField fx:id="emailOrUsername" layoutX="176.0" layoutY="64.0" promptText="Email or Username" style="-fx-background-color: white; -fx-border-width: 1px;" />
                     <TextField fx:id="loginPassword" layoutX="176.0" layoutY="184.0" promptText="Password" />
                     <Label fx:id="loginText" layoutX="163.0" layoutY="249.0" prefHeight="18.0" prefWidth="187.0" textFill="RED" />
                  </children>
               </AnchorPane>
         </content>
       </Tab>
     </tabs>
   </TabPane>

    <Label fx:id="welcomeText" />
</VBox>
